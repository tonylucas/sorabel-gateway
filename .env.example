# Copier vers .env et ajuster si besoin. Aucune valeur ci-dessous n'est un secret réel.

# Base vectorielle (docker compose expose Chroma sur 8002)
CHROMA_URL=http://localhost:8002

# Modèle d'embeddings (fastembed, ONNX). Doit figurer au catalogue fastembed :
# un modèle inconnu fait échouer l'ingestion et le retrieval.
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Base SQL Sorabel (SQLite, générée par `make seed`). Elle reste la référence
# des tests d'acceptance, qui y calculent leurs attendus.
SORABEL_DB=data/sorabel.db

# PostgreSQL — variables libpq standard, lues telles quelles par psycopg.
# Ces valeurs visent le conteneur de `docker compose up` ; pour Azure, mettre
# le FQDN du serveur et PGSSLMODE=require (cf. docs/deploiement.md § 3.1).
# Ce compte est l'administrateur : il ne sert qu'à `make migrate` et `make roles`.
PGHOST=localhost
PGPORT=8003
PGDATABASE=sorabel
PGUSER=sorabel
PGPASSWORD=sorabel
PGSSLMODE=prefer

# Un mot de passe par rôle, créés par `make roles` depuis `access.yaml`.
# En production, ces quatre valeurs vivent dans Secret Manager.
PG_SUPPORT=
PG_COMMERCIAL=
PG_DEV=
PG_CATALOG=

# Journal des appels de la gateway
GATEWAY_JOURNAL=logs/journal.jsonl

# Profil client par défaut du serveur MCP (support | commercial)
SORABEL_PROFILE=support

# Clé API Gemini, côté serveur Python (génération SQL)
# https://aistudio.google.com/apikey — l'app bot a sa propre clé dans ui/.env
GOOGLE_API_KEY=

# Modèle Gemini de génération SQL (défaut : gemini-3.5-flash-lite)
SORABEL_SQL_MODEL=gemini-3.5-flash-lite

# Port d'écoute du canal Streamable HTTP (route /mcp)
PORT=8000
