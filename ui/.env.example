# Copier vers .env. Aucune valeur ci-dessous n'est un secret réel.

# Clé API Gemini de l'app bot — https://aistudio.google.com/apikey
# Distincte de celle du serveur Python (.env du dépôt) : deux services, deux clés.
GOOGLE_API_KEY=

# Modèle utilisé par l'agent CopilotKit
GEMINI_MODEL=google/gemini-3.7-flash

# Serveur MCP de la gateway (make serve-http)
MCP_URL=http://127.0.0.1:8000/mcp

# Secret partagé envoyé à la gateway (facultatif tant que la barrière 2 n'existe pas)
SORABEL_KEY=

# Télémétrie CopilotKit
COPILOTKIT_TELEMETRY_DISABLED=true
