# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
.python-version

# Environnements & secrets
.env
.env.*
!.env.example

# Outils
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Données locales & runtime
.docker-data/
chroma-data/
.chroma/
logs/*.jsonl
# `-wal` et `-shm` sont les fichiers annexes du mode WAL de SQLite :
# dérivés, transitoires, reconstruits seuls.
data/sorabel.db*

# IDE / OS
.idea/
# `.vscode/` sans étoile exclurait le dossier entier, et git n'y descendrait
# plus : les ré-inclusions ci-dessous seraient sans effet.
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.DS_Store
